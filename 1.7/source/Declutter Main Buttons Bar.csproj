<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Declutter UI</AssemblyName>
    <RootNamespace>Declutter_Main_Buttons_Bar</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../Base/Assemblies/</OutputPath>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/RimWorld</RimWorldDir>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">C:/Me/Games/Rimworld/Harmony/1.7/0Harmony.dll</HarmonyDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>none</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldDir)/Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
    <Publicize Include="Assembly-CSharp:Verse.GizmoGridDrawer.GizmoSpacing" />
    <Publicize Include="Assembly-CSharp:Verse.GizmoGridDrawer.GizmoStartX" />
    <Publicize Include="Assembly-CSharp:RimWorld.PlaySettings.DoMapControls" />
    <Publicize Include="Assembly-CSharp:RimWorld.PlaySettings.DoPlaySettingsGlobalControls" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="!Exists('$(RimWorldDir)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll missing from RimWorldDir: $(RimWorldDir)" />
    <Error Condition="!Exists('$(RimWorldDir)/UnityStubs.dll')" Text="UnityStubs.dll missing from RimWorldDir: $(RimWorldDir)" />
    <Error Condition="!Exists('$(RimWorldDir)/Waylith.dll')" Text="Waylith.dll missing from RimWorldDir: $(RimWorldDir)" />
    <Error Condition="!Exists('$(HarmonyDll)')" Text="Harmony 3 0Harmony.dll missing: $(HarmonyDll)" />
  </Target>
</Project>
